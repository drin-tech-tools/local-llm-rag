# Copy to .env.local. Every value has a working default for a local Ollama install,
# so you only need this file to change models or point at another server.

# OpenAI-compatible model server. Ollama serves this on port 11434.
# Team server later: e.g. http://gpu-box:8000/v1 for vLLM.
# LLM_BASE_URL=http://localhost:11434/v1

# Only needed if the server requires a key (vLLM --api-key, hosted gateways). Ollama ignores it.
# LLM_API_KEY=

# Embedding model. Changing it means re-uploading your documents.
# EMBED_MODEL=nomic-embed-text

# Chat model. 16 GB Mac: llama3.1:8b (default). 8 GB Mac or faster answers: llama3.2:3b.
# CHAT_MODEL=llama3.1:8b

# Number of chunks retrieved per question.
# RAG_TOP_K=5

# How long to wait for the first token. The first question after a restart loads
# the model into memory, which can take 30-60 s on a MacBook Air.
# CHAT_FIRST_TOKEN_TIMEOUT_MS=120000

# Where uploaded documents and embeddings are stored.
# DATA_DIR=./data
